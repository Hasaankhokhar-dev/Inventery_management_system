@page
@model FinalInventerySystem.Pages.Invoices.CreateModel
@{
    ViewData["Title"] = "Create Invoice";
}

<style>
    @@keyframes highlightFade {
        0% {
            background-color: #e8f5e8;
        }

        100% {
            background-color: #ffffff;
        }
    }

    .new-item-highlight {
        animation: highlightFade 1.5s ease-in-out;
    }

    #productResults {
        z-index: 1000;
        max-height: 200px;
        overflow-y: auto;
        display: none;
        border: 1px solid #ddd;
        border-radius: 5px;
    }

        #productResults li {
            cursor: pointer;
        }

            #productResults li:hover {
                background-color: #f8f9fa;
            }

    .price-input {
        max-width: 110px;
        border: 1px solid #ced4da;
        border-radius: 4px;
        padding: 4px 8px;
        font-weight: bold;
        color: #198754;
        text-align: right;
    }

        .price-input:focus {
            border-color: #0d6efd;
            outline: none;
            box-shadow: 0 0 0 2px rgba(13,110,253,0.2);
        }

    .price-changed {
        border-color: #ffc107 !important;
        background-color: #fffbf0 !important;
        color: #856404 !important;
    }

    .quick-add-btn {
        cursor: pointer;
        background-color: #fff3cd;
        border-left: 3px solid #ffc107;
    }

        .quick-add-btn:hover {
            background-color: #ffe69c;
        }

    .update-price-label {
        display: none;
        font-size: 10px;
        color: #856404;
        cursor: pointer;
    }
</style>

<div class="container mt-5">
    <div class="card shadow-lg border-0 rounded-3">
        <div class="card-header text-white py-3"
             style="background: linear-gradient(90deg, #0062E6, #33AEFF);">
            <h4 class="mb-0">📝 Create New Invoice</h4>
        </div>

        <div class="card-body">
            <form method="post">
                @Html.AntiForgeryToken()
                <input type="hidden" asp-for="ReturnPage" />

                <!-- Customer Info -->
                <div class="row mb-4">
                    <div class="col-md-4">
                        <label asp-for="Invoice.CustomerName" class="form-label fw-bold">Customer Name</label>
                        <input asp-for="Invoice.CustomerName" class="form-control"
                               placeholder="Enter customer name" required />
                        <span asp-validation-for="Invoice.CustomerName" class="text-danger small"></span>
                    </div>
                    <div class="col-md-4">
                        <label asp-for="Invoice.Phone" class="form-label fw-bold">Phone</label>
                        <input asp-for="Invoice.Phone" class="form-control"
                               placeholder="e.g. 0300-1234567" />
                        <span asp-validation-for="Invoice.Phone" class="text-danger small"></span>
                    </div>
                    <div class="col-md-4">
                        <label asp-for="Invoice.Address" class="form-label fw-bold">Address</label>
                        <input asp-for="Invoice.Address" class="form-control"
                               placeholder="Customer address" />
                        <span asp-validation-for="Invoice.Address" class="text-danger small"></span>
                    </div>
                </div>

                <!-- Product Search -->
                <div class="mb-4 position-relative">
                    <label class="form-label fw-bold">
                        🔎 Search Product
                        <small class="text-muted fw-normal ms-2">(F2 shortcut)</small>
                    </label>
                    <input type="text" id="productSearch" class="form-control"
                           placeholder="Type product name..." autocomplete="off" />
                    <ul id="productResults" class="list-group position-absolute w-100 mt-1"></ul>
                </div>

                <!-- Invoice Items -->
                <h5 class="text-primary fw-bold mb-3">🛒 Invoice Items</h5>
                <div class="table-responsive">
                    <table id="invoiceItems" class="table table-bordered table-striped shadow-sm">
                        <thead class="table-primary text-center align-middle">
                            <tr>
                                <th style="width:22%;">Product</th>
                                <th style="width:10%;">Stock</th>
                                <th style="width:20%;">
                                    Price
                                    <small class="d-block fw-normal text-white-50" style="font-size:10px;">
                                        (Editable)
                                    </small>
                                </th>
                                <th style="width:18%;">Quantity</th>
                                <th style="width:15%;">Subtotal</th>
                                <th style="width:15%;">Action</th>
                            </tr>
                        </thead>
                        <tbody class="align-middle">
                        </tbody>
                        <tfoot>
                            <tr>
                                <td colspan="4" class="text-end fw-bold">💵 Total:</td>
                                <td class="text-end fw-bold text-success" id="grandTotal">Rs. 0</td>
                                <td></td>
                            </tr>
                        </tfoot>
                    </table>
                </div>

                <!-- Actions -->
                <div class="mt-4 d-flex justify-content-between">
                    <a asp-page="Index" asp-route-pageIndex="@Model.ReturnPage"
                       class="btn btn-outline-secondary px-4">
                        <i class="bi bi-arrow-left"></i> Cancel
                    </a>
                    <button type="submit" class="btn btn-success px-4">
                        <i class="bi bi-save"></i> Save Invoice
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>

<!-- Quick Add Modal -->
<div class="modal fade" id="quickAddModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header text-white"
                 style="background: linear-gradient(90deg, #ff6b35, #f7931e);">
                <h5 class="modal-title">➕ Add New Product</h5>
                <button type="button" class="btn-close btn-close-white"
                        data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body">
                <div class="mb-3">
                    <label class="form-label fw-bold">
                        Product Name <span class="text-danger">*</span>
                    </label>
                    <input type="text" id="quickProductName" class="form-control"
                           placeholder="Enter product name" />
                </div>
                <div class="mb-3">
                    <label class="form-label fw-bold">
                        Price (Rs.) <span class="text-danger">*</span>
                    </label>
                    <input type="number" id="quickProductPrice" class="form-control"
                           placeholder="e.g. 500" min="1" step="0.01" />
                    <small class="text-muted">Default price — can be changed per invoice</small>
                </div>
                <div class="mb-3">
                    <label class="form-label fw-bold">Stock Quantity</label>
                    <input type="number" id="quickProductStock" class="form-control"
                           placeholder="e.g. 10" min="0" value="0" />
                    <small class="text-muted">Stock quantity to add in inventory</small>
                </div>
                <div id="quickAddAlert" class="alert d-none"></div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary"
                        data-bs-dismiss="modal">
                    Cancel
                </button>
                <button type="button" class="btn btn-warning fw-bold" id="quickAddSaveBtn">
                    <i class="bi bi-plus-circle"></i> Add & Add to Invoice
                </button>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
    <script>

        // ✅ Search products
        $("#productSearch").on("keyup", function() {
            let query = $(this).val();
            if (query.length < 1) {
                $("#productResults").empty().hide();
                return;
            }

            $.getJSON("/Invoices/SearchProducts", { query: query }, function(results) {
                let list = "";
                if (results.length > 0) {
                    results.forEach(p => {
                        list += `<li class="list-group-item list-group-item-action"
                                            data-id="${p.id}" data-name="${p.name}"
                                            data-price="${p.basePrice}" data-stock="${p.quantity}">
                                            <strong>${p.name}</strong><br>
                                            <small>Stock: ${p.quantity} | Default Price: Rs. ${p.basePrice.toLocaleString()}</small>
                                         </li>`;
                    });
                } else {
                    list += `<li class="list-group-item quick-add-btn"
                                        id="quickAddTrigger" data-name="${query}">
                                        ➕ "<strong>${query}</strong>" not found —
                                        <span class="text-warning fw-bold">Add New Product</span>
                                     </li>`;
                }
                $("#productResults").html(list).show();
            }).fail(function() {
                $("#productResults").html(
                    '<li class="list-group-item text-danger">Search failed.</li>'
                ).show();
            });
        });

        // ✅ Quick Add trigger
        $(document).on("click", "#quickAddTrigger", function() {
            let name = $(this).data("name");
            $("#quickProductName").val(name);
            $("#quickProductPrice").val("");
            $("#quickProductStock").val("0");
            $("#quickAddAlert").addClass("d-none").text("");
            $("#productResults").empty().hide();
            $("#productSearch").val("");
            new bootstrap.Modal(document.getElementById('quickAddModal')).show();
            setTimeout(() => $("#quickProductPrice").focus(), 400);
        });

        // ✅ Quick Add save
        $("#quickAddSaveBtn").on("click", function() {
            let name = $("#quickProductName").val().trim();
            let price = parseFloat($("#quickProductPrice").val());
            let stock = parseInt($("#quickProductStock").val()) || 0;

            if (!name) { showQuickAlert("danger", "❌ Product name is required!"); return; }
            if (!price || price <= 0) { showQuickAlert("danger", "❌ Enter a valid price!"); return; }

            $("#quickAddSaveBtn").prop("disabled", true).text("Saving...");

            $.ajax({
                url: "?handler=AddQuickProduct",
                method: "POST",
                contentType: "application/json",
                headers: {
                    "RequestVerificationToken": $('input[name="__RequestVerificationToken"]').val()
                },
                data: JSON.stringify({ name: name, basePrice: price, quantity: stock }),
                success: function(response) {
                    if (response.success) {
                        showQuickAlert(
                            response.isExisting ? "warning" : "success",
                            "✅ " + response.message
                        );
                        setTimeout(() => {
                            addProductToInvoice(
                                response.id, response.name,
                                response.basePrice, response.quantity
                            );
                            bootstrap.Modal.getInstance(
                                document.getElementById('quickAddModal')
                            ).hide();
                        }, 800);
                    } else {
                        showQuickAlert("danger", "❌ " + response.message);
                    }
                },
                error: function() {
                    showQuickAlert("danger", "❌ Server error! Please try again.");
                },
                complete: function() {
                    $("#quickAddSaveBtn").prop("disabled", false)
                        .html('<i class="bi bi-plus-circle"></i> Add & Add to Invoice');
                }
            });
        });

        function showQuickAlert(type, message) {
            $("#quickAddAlert")
                .removeClass("d-none alert-success alert-danger alert-warning")
                .addClass("alert-" + type).html(message);
        }

        // ✅ FIX 1: Indexes reorder karo - delete ke baad
        function reorderIndexes() {
            $("#invoiceItems tbody tr").each(function(index) {
                $(this).find("input.inventory-id").attr("name", `SelectedItems[${index}].InventoryId`);
                $(this).find("input.custom-price").attr("name", `SelectedItems[${index}].CustomPrice`);
                $(this).find("input.qty").attr("name", `SelectedItems[${index}].Quantity`);
                $(this).find("input.update-inventory-cb").attr("name", `SelectedItems[${index}].UpdateInventoryPrice`);
            });
        }

        // ✅ Product invoice table mein add karo
        function addProductToInvoice(id, name, price, stock) {
            let existingRow = $(`#invoiceItems tbody tr input.inventory-id[value="${id}"]`).closest('tr');
            if (existingRow.length > 0) {
                let qtyInput = existingRow.find('.qty');
                let current = parseFloat(qtyInput.val()) || 0;
                let newQty = current + 1;
                if (newQty <= stock) {
                    qtyInput.val(newQty).trigger('input');
                    existingRow.addClass('new-item-highlight');
                    setTimeout(() => existingRow.removeClass('new-item-highlight'), 1500);
                } else {
                    alert(`❌ Maximum stock limit! Only ${stock} available.`);
                }
                return;
            }

            let rowCount = $("#invoiceItems tbody tr").length;

            let row = `
                        <tr class="align-middle text-center new-item-highlight">
                            <td class="text-start">
                                <strong>${name}</strong>
                                <input type="hidden"
                                       class="inventory-id"
                                       name="SelectedItems[${rowCount}].InventoryId"
                                       value="${id}" />
                            </td>
                            <td><span class="badge bg-secondary">${stock}</span></td>
                            <td class="text-center">
                                <div class="d-flex align-items-center justify-content-center gap-1">
                                    <span class="text-muted small">Rs.</span>
                                    <input type="number"
                                           name="SelectedItems[${rowCount}].CustomPrice"
                                           class="price-input custom-price"
                                           value="${price}"
                                           min="0"
                                           step="0.01"
                                           data-default="${price}"
                                           title="You can change this price" />
                                </div>
                                <div class="mt-1">
                                    <small class="text-muted" style="font-size:10px;">
                                        Default: Rs. ${parseFloat(price).toLocaleString()}
                                    </small><br>
                                    <label class="update-price-label mt-1">
                                        <input type="checkbox"
                                               name="SelectedItems[${rowCount}].UpdateInventoryPrice"
                                               class="update-inventory-cb me-1"
                                               value="true" />
                                        Update inventory price too?
                                    </label>
                                </div>
                            </td>
                            <td>
                                <div class="input-group input-group-sm mx-auto" style="max-width: 130px;">
                                    <button class="btn btn-outline-secondary minus-btn" type="button">-</button>
                                    <input type="number"
                                           name="SelectedItems[${rowCount}].Quantity"
                                           value="1"
                                           min="0.1"
                                           max="${stock}"
                                           step="0.1"
                                           class="form-control form-control-sm qty text-center" />
                                    <button class="btn btn-outline-secondary plus-btn" type="button">+</button>
                                </div>
                            </td>
                            <td class="subtotal text-end fw-bold text-success">
                                Rs. ${parseFloat(price).toLocaleString()}
                            </td>
                            <td>
                                <button type="button" class="btn btn-sm btn-danger removeItem">
                                    <i class="bi bi-trash"></i> Remove
                                </button>
                            </td>
                        </tr>`;

            $("#invoiceItems tbody").prepend(row);
            reorderIndexes();
            recalcTotals();
            setTimeout(() => $("#invoiceItems tbody tr:first .qty").focus().select(), 100);
        }

        // ✅ Existing product click
        $(document).on("click", "#productResults li:not(#quickAddTrigger)", function() {
            addProductToInvoice(
                $(this).data("id"),
                $(this).data("name"),
                parseFloat($(this).data("price")),
                $(this).data("stock")
            );
            $("#productResults").empty().hide();
            $("#productSearch").val("");
        });

        // ✅ Price change hone pe checkbox show karo
        $(document).on("input", ".custom-price", function() {
            let defaultPrice = parseFloat($(this).data("default"));
            let currentPrice = parseFloat($(this).val());
            let row = $(this).closest("tr");
            let label = row.find(".update-price-label");
            let cb = row.find(".update-inventory-cb");

            if (currentPrice !== defaultPrice && currentPrice > 0) {
                $(this).addClass("price-changed");
                label.show();
            } else {
                $(this).removeClass("price-changed");
                label.hide();
                cb.prop("checked", false);
            }
            recalcTotals();
        });

        // ✅ FIX 1: Remove item + reorder indexes
        $(document).on("click", ".removeItem", function() {
            if (confirm("Are you sure?")) {
                $(this).closest("tr").remove();
                reorderIndexes();
                recalcTotals();
            }
        });

        // ✅ FIX 2: Float quantity - + button 0.1 step
        $(document).on("click", ".plus-btn", function() {
            let input = $(this).siblings(".qty");
            let max = parseFloat(input.attr("max"));
            let current = parseFloat(input.val()) || 0;
            let newVal = Math.round((current + 0.1) * 10) / 10;
            if (newVal <= max) {
                input.val(newVal).trigger("input");
            } else {
                alert(`❌ Maximum stock! Only ${max} available.`);
            }
        });

        $(document).on("click", ".minus-btn", function() {
            let input = $(this).siblings(".qty");
            let current = parseFloat(input.val()) || 0.1;
            let newVal = Math.round((current - 0.1) * 10) / 10;
            if (newVal >= 0.1) {
                input.val(newVal).trigger("input");
            }
        });

        // ✅ Recalculate totals - float support
        $(document).on("input", ".qty, .custom-price", recalcTotals);

        function recalcTotals() {
            let total = 0;
            $("#invoiceItems tbody tr").each(function() {
                let qty = parseFloat($(this).find(".qty").val()) || 0;
                let price = parseFloat($(this).find(".custom-price").val()) || 0;
                let subtotal = Math.round(qty * price * 100) / 100;
                $(this).find(".subtotal").text("Rs. " + subtotal.toLocaleString());
                total += subtotal;
            });
            $("#grandTotal").text("Rs. " + (Math.round(total * 100) / 100).toLocaleString());
        }

        // ✅ Keyboard shortcuts
        $(document).on('keydown', function(e) {
            if (e.key === 'F2') {
                e.preventDefault();
                $("#productSearch").focus();
                return false;
            }
            if (e.ctrlKey && e.key === 's') {
                e.preventDefault();
                $("form").submit();
                return false;
            }
            if (e.key === 'Escape') {
                $("#productResults").empty().hide();
                $("#productSearch").val("");
            }
        });

        $(document).on('click', function(e) {
            if (!$(e.target).closest('#productSearch, #productResults').length) {
                $("#productResults").hide();
            }
        });

        $("#productSearch").on('focus', function() {
            if ($("#productResults").children().length > 0) {
                $("#productResults").show();
            }
        });

        $("#quickAddModal").on("keydown", function(e) {
            if (e.key === "Enter") {
                e.preventDefault();
                $("#quickAddSaveBtn").click();
            }
        });
    </script>
}
